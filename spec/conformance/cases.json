{
  "$comment": "Shared behaviour cases. The Python and .NET test suites both run every case, so the two implementations must agree. 'error' is the exact message; 'error_prefix' is used where the text after it comes from the language's own JSON parser. '{path}' stands for the data file's path.",
  "mapping_validation": [
    {
      "name": "minimal mapping gets defaults",
      "mapping": {
        "target_url": "https://x.example",
        "fields": {}
      },
      "result": {
        "version": 1,
        "form_selector": "form"
      }
    },
    {
      "name": "full mapping",
      "mapping": {
        "$schema": "x",
        "version": 1,
        "name": "n",
        "description": "d",
        "target_url": "http://127.0.0.1:5000/form-b",
        "form_selector": "form#c",
        "fields": {
          "name": "#n"
        },
        "source": {
          "url": "file:///tmp/a.html",
          "fields": {
            "name": "#a"
          }
        },
        "synonyms": {
          "message": [
            "how can we help"
          ]
        }
      },
      "result": {
        "version": 1,
        "form_selector": "form#c"
      }
    },
    {
      "name": "uppercase scheme allowed",
      "mapping": {
        "target_url": "HTTPS://X.EXAMPLE",
        "fields": {}
      },
      "result": {
        "version": 1,
        "form_selector": "form"
      }
    },
    {
      "name": "top level must be object",
      "mapping": [],
      "error": "mapping: top level must be a JSON object"
    },
    {
      "name": "missing target_url",
      "mapping": {
        "fields": {}
      },
      "error": "mapping: missing required key 'target_url'"
    },
    {
      "name": "missing fields",
      "mapping": {
        "target_url": "https://x.example"
      },
      "error": "mapping: missing required key 'fields'"
    },
    {
      "name": "javascript url rejected",
      "mapping": {
        "target_url": "javascript:alert(1)",
        "fields": {}
      },
      "error": "mapping: target_url must start with http://, https:// or file:// (got 'javascript:alert(1)')"
    },
    {
      "name": "empty target_url",
      "mapping": {
        "target_url": "  ",
        "fields": {}
      },
      "error": "mapping: target_url must be a non-empty string"
    },
    {
      "name": "non-string target_url",
      "mapping": {
        "target_url": 5,
        "fields": {}
      },
      "error": "mapping: target_url must be a non-empty string"
    },
    {
      "name": "empty selector",
      "mapping": {
        "target_url": "https://x.example",
        "fields": {
          "a": ""
        }
      },
      "error": "mapping: fields.a must be a non-empty CSS selector string"
    },
    {
      "name": "non-string selector",
      "mapping": {
        "target_url": "https://x.example",
        "fields": {
          "a": 1
        }
      },
      "error": "mapping: fields.a must be a non-empty CSS selector string"
    },
    {
      "name": "fields not an object",
      "mapping": {
        "target_url": "https://x.example",
        "fields": []
      },
      "error": "mapping: fields must be an object of field name -> CSS selector"
    },
    {
      "name": "typo key",
      "mapping": {
        "target_url": "https://x.example",
        "fields": {},
        "feilds": {}
      },
      "error": "mapping: unknown key(s) ['feilds']; check for typos"
    },
    {
      "name": "several unknown keys sorted",
      "mapping": {
        "target_url": "https://x.example",
        "fields": {},
        "zeta": 1,
        "alpha": 2
      },
      "error": "mapping: unknown key(s) ['alpha', 'zeta']; check for typos"
    },
    {
      "name": "unsupported version",
      "mapping": {
        "target_url": "https://x.example",
        "fields": {},
        "version": 9
      },
      "error": "mapping: unsupported version 9; this CrossFill reads version 1"
    },
    {
      "name": "empty form_selector",
      "mapping": {
        "target_url": "https://x.example",
        "fields": {},
        "form_selector": ""
      },
      "error": "mapping: form_selector must be a non-empty CSS selector"
    },
    {
      "name": "source not an object",
      "mapping": {
        "target_url": "https://x.example",
        "fields": {},
        "source": "x"
      },
      "error": "mapping: source must be an object"
    },
    {
      "name": "bad source url",
      "mapping": {
        "target_url": "https://x.example",
        "fields": {},
        "source": {
          "url": "ftp://x"
        }
      },
      "error": "mapping: source.url must start with http://, https:// or file:// (got 'ftp://x')"
    },
    {
      "name": "bad source fields",
      "mapping": {
        "target_url": "https://x.example",
        "fields": {},
        "source": {
          "fields": {
            "a": " "
          }
        }
      },
      "error": "mapping: source.fields.a must be a non-empty CSS selector string"
    },
    {
      "name": "empty synonym list",
      "mapping": {
        "target_url": "https://x.example",
        "fields": {},
        "synonyms": {
          "a": []
        }
      },
      "error": "mapping: synonyms must map each field name to a non-empty list of strings"
    },
    {
      "name": "synonyms not an object",
      "mapping": {
        "target_url": "https://x.example",
        "fields": {},
        "synonyms": [
          "a"
        ]
      },
      "error": "mapping: synonyms must map each field name to a non-empty list of strings"
    },
    {
      "name": "empty synonym word",
      "mapping": {
        "target_url": "https://x.example",
        "fields": {},
        "synonyms": {
          "a": [
            ""
          ]
        }
      },
      "error": "mapping: synonyms must map each field name to a non-empty list of strings"
    }
  ],

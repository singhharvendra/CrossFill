<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CrossFill.Cli</RootNamespace>
    <AssemblyName>crossfill</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>crossfill</ToolCommandName>
    <PackageId>CrossFill.Cli</PackageId>
    <!-- Playwright ships helper .ps1 scripts; NuGet warns that it will not run them, which is expected. -->
    <NoWarn>$(NoWarn);NU5111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrossFill.Core\CrossFill.Core.csproj" />
    <ProjectReference Include="..\CrossFill.Web\CrossFill.Web.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrossFill</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>CrossFill.Core</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.65.1" />
  </ItemGroup>

  <!-- Shared spec files, linked (not copied) from ../../../spec, placed next to the binaries
       and shipped to package consumers. -->
  <ItemGroup>
    <Content Include="$(SpecDir)mappings\*.json" Link="mappings\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             PackagePath="contentFiles\any\any\mappings\" PackageCopyToOutput="true" />
    <Content Include="$(SpecDir)schema\*.json" Link="schema\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             PackagePath="contentFiles\any\any\schema\" PackageCopyToOutput="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrossFill.Tests" />
    <InternalsVisibleTo Include="CrossFill.Web" />
    <InternalsVisibleTo Include="crossfill" />
  </ItemGroup>

</Project>

<Project>
  <!-- Shared by every project in dotnet/. Keep <Version> in step with python/crossfill/__init__.py
       (a test checks this). -->
  <PropertyGroup>
    <Version>0.2.0</Version>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <Authors>Harvendra Singh</Authors>
    <Description>Copy data from one web application into another's form with automatic field matching. A human always presses Submit.</Description>
    <PackageLicenseExpression>MIT-0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/singhharvendra/CrossFill</PackageProjectUrl>
    <RepositoryUrl>https://github.com/singhharvendra/CrossFill</RepositoryUrl>
    <PackageTags>playwright;form-filling;automation;data-entry;rpa;human-in-the-loop</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>false</IsPackable>

    <!-- The shared spec/ folder at the repository root. -->
    <SpecDir>$(MSBuildThisFileDirectory)..\spec\</SpecDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
